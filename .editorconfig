# https://editorconfig.org/

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# JavaScript/TypeScript files
[*.{js,jsx,ts,tsx}]
indent_size = 2
quote_type = single
curly_bracket_next_line = false
spaces_around_operators = true
keep_indentation = false

# Python files
[*.py]
indent_size = 4
max_line_length = 79

# HTML/CSS/Markdown
[*.{html,css,md}]
indent_size = 2
end_of_line = lf

# JSON/YAML
[*.{json,yml,yaml}]
indent_size = 2
